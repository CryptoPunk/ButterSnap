{
  "name": "buttersync",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "concurrently \"vite\" \"bun run serve:snap\"",
    "build": "vite build && bun x publint",
    "lint": "tsc --noEmit",
    "check": "publint",
    "test": "bun test src index.test.ts",
    "serve:snap": "snapserver -c snaptest.conf",
    "cypress:run": "cypress run"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "cypress": "^15.13.0",
    "esbuild": "^0.27.4",
    "publint": "^0.3.18",
    "typescript": "^6.0.0-dev.20260324",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@wasm-audio-decoders/flac": "^0.2.10",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "@wasm-audio-decoders/opus-ml": "^0.0.2",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7"
  }
}
